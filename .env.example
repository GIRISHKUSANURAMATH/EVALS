# Copy to .env (project root or backend/) and adjust. Every value is optional.
# NEVER commit your real .env file.

# Database (SQLite by default; the schema is PostgreSQL-compatible)
# EVALS_DATABASE_URL=sqlite:///data/evals.db
# EVALS_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/evals

# JSON list of allowed browser origins
EVALS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Upload limits
EVALS_MAX_UPLOAD_MB=25
EVALS_MAX_RECORDS_PER_UPLOAD=200000

# Admin key: enables destructive operations (database reset, dataset delete, settings changes).
# Leave empty to keep them disabled. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EVALS_ADMIN_API_KEY=

# Privacy: keep unredacted text alongside redacted text (OFF by default, never exported)
EVALS_PRESERVE_RAW_CONTENT=false
EVALS_REDACT_IP_ADDRESSES=true

# Pipeline defaults (can also be changed at runtime on the Settings page)
EVALS_LATENCY_THRESHOLD_MS=10000
EVALS_SIMILARITY_THRESHOLD=0.9
EVALS_CLUSTERING_METHOD=kmeans

# Optional semantic embeddings (requires: pip install -r backend/requirements-embeddings.txt)
EVALS_USE_EMBEDDINGS=false
EVALS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional LLM-suggested expected outputs: none | openai_compatible
EVALS_LLM_PROVIDER=none
